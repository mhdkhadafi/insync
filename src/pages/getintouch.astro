---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Get in Touch" description="Stay updated on IN SYNC workshops and events">

  <div class="contact-header">
    <div class="contact-header-inner">
      <h1 class="contact-heading">Stay in the loop</h1>
      <p class="contact-subheading">Get updates on upcoming workshops and events.</p>
    </div>
  </div>

  <section class="contact-body">
    <div class="contact-inner">

      <div class="contact-block">
        <p class="contact-p">
          IN SYNC runs workshops throughout the year — usually at local small businesses in Jackson Heights. If you'd like to hear about new dates and themes before they fill up, get on the list.
        </p>
        <p class="contact-p contact-p--cta">
          Just send an email with your name and I'll add you.
        </p>
        <a href="mailto:insyncnyc@gmail.com?subject=Add me to the IN SYNC newsletter" class="contact-cta">
          Email me to get on the newsletter
        </a>
      </div>

      <div class="contact-divider"></div>

      <div class="contact-block">
        <h2 class="contact-section-title">Other questions?</h2>
        <p class="contact-p">
          Feel free to reach out at <a href="mailto:insyncnyc@gmail.com" class="contact-link">insyncnyc@gmail.com</a> — whether it's about a specific event, hosting a workshop, or just saying hi.
        </p>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .contact-header {
    background: var(--color-dark);
    padding: 80px 48px 56px;
  }
  .contact-header-inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .contact-heading {
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 600;
    color: var(--color-cream);
    line-height: 1.1;
    margin-bottom: 14px;
  }
  .contact-subheading {
    font-family: var(--font-serif);
    font-size: 24px;
    font-style: italic;
    font-weight: 300;
    color: rgba(250,246,241,0.88);
  }

  .contact-body {
    background: var(--color-cream);
    padding: 64px 48px 96px;
  }
  .contact-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .contact-block {
    padding: 48px 0;
  }
  .contact-block:first-child { padding-top: 0; }

  .contact-divider {
    height: 1px;
    background: rgba(0,0,0,0.08);
  }

  .contact-section-title {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 600;
    color: var(--color-coral);
    margin-bottom: 24px;
  }

  .contact-p {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 400;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: 22px;
  }
  .contact-p:last-child { margin-bottom: 0; }
  .contact-p--cta { margin-bottom: 32px; }

  .contact-cta {
    display: inline-block;
    background: var(--color-coral);
    color: var(--color-cream);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 28px;
    transition: opacity 0.2s;
  }
  .contact-cta:hover { opacity: 0.85; }

  .contact-link {
    color: var(--color-coral);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-link:hover { opacity: 0.8; }

  @media (max-width: 768px) {
    .contact-header { padding: 48px 20px 40px; }
    .contact-heading { font-size: 36px; }
    .contact-body { padding: 40px 20px 72px; }
  }
</style>
