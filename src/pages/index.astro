---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const sorted = allEvents.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const today = new Date();
const featuredEvent = sorted.find(e => e.data.date >= today) ?? sorted[0];
const isUpcoming = featuredEvent ? featuredEvent.data.date >= today : false;
const pastEvents = sorted.filter(e => e.data.date < today && e.data.image && e.data.series === 'Writing Workshop Series');

const allBooks = await getCollection('books');
const sortedBooks = allBooks.sort((a, b) => b.data.dateAdded.getTime() - a.data.dateAdded.getTime());

const heroDateStr = featuredEvent
  ? featuredEvent.data.date.toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric' })
  : '';
const heroTimeStr = featuredEvent
  ? featuredEvent.data.date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' })
  : '';
const heroSubtitle = featuredEvent?.data.series || featuredEvent?.data.category || '';
---

<BaseLayout title="Home" description="IN SYNC — Writing workshops for creative minds in diaspora">

  <!-- 1. HERO -->
  <section class="hero">

    <div class="hero-event">
      {featuredEvent?.data.image && (
        <div class="hero-bg" style={`background-image: url('${featuredEvent.data.image}')`}></div>
      )}
      <div class="hero-tint"></div>

      <div class="hero-card">
        <span class="hero-eyebrow">
          {isUpcoming ? 'Upcoming Workshop' : 'Past Workshop'}
        </span>
        <h1 class="hero-title">{featuredEvent?.data.title}</h1>
        {featuredEvent?.data.tagline && (
          <p class="hero-tagline">{featuredEvent.data.tagline}</p>
        )}
        <div class="hero-rule"></div>
        {heroSubtitle && <p class="hero-series">{heroSubtitle}</p>}
        <p class="hero-meta">{heroDateStr}</p>
        {heroTimeStr && <p class="hero-meta">{heroTimeStr}</p>}
        {featuredEvent?.data.location && (
          <p class="hero-meta hero-location">{featuredEvent.data.location}</p>
        )}
        <div class="hero-btns">
          {featuredEvent && (
            <a href={`/events/${featuredEvent.slug}`} class="btn btn-outline">
              {isUpcoming ? 'More Info' : 'View Recap'}
            </a>
          )}
          {isUpcoming && featuredEvent?.data.rsvpUrl && (
            <a href={featuredEvent.data.rsvpUrl} target="_blank" rel="noopener noreferrer" class="btn btn-solid">
              Register
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Right: who is this for -->
    <div class="hero-messaging">
      <p class="hero-msg-headline">For the writer who keeps saying <em>"maybe next week."</em></p>
      <div class="hero-msg-items">
        <div class="hero-msg-item">
          <p class="hero-msg-title">Life is full. We carve out the hour.</p>
          <p class="hero-msg-body">One workshop at a time. No prep, no pressure. Just show up and write.</p>
        </div>
        <div class="hero-msg-item">
          <p class="hero-msg-title">Find your people in Queens.</p>
          <p class="hero-msg-body">A room of writers who know what it means to carry more than one world.</p>
        </div>
        <div class="hero-msg-item">
          <p class="hero-msg-title">Your voice, clearer than before.</p>
          <p class="hero-msg-body">Workshops that cut through the noise so you can hear yourself again.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. ABOUT QUOTE -->
  <section class="about-section">
    <div class="about-rule"></div>
    <p class="about-quote">
      A writing workshop for <strong>creative minds in diaspora</strong> —
      to explore cultural identity, find your voice, and write toward authenticity.
    </p>
    <a href="/about" class="about-cta">Our Story →</a>
  </section>

  <!-- 4. PAST WORKSHOPS CAROUSEL -->
  {pastEvents.length > 0 && (
    <section class="past-section">
      <div class="past-header">
        <p class="eyebrow">Past Workshops</p>
        {pastEvents.length > 3 && (
          <div class="carousel-controls">
            <button class="carousel-btn" id="prev-btn" aria-label="Previous" disabled>←</button>
            <button class="carousel-btn" id="next-btn" aria-label="Next">→</button>
          </div>
        )}
      </div>
      <div class="carousel-viewport">
        <div class="carousel-track" id="carousel-track">
          {pastEvents.map(event => {
            const cardDate = event.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            return (
              <a href={`/events/${event.slug}`} class="past-card">
                <img src={event.data.image} alt={event.data.title} class="past-card-img" />
                <div class="past-card-body">
                  <p class="past-card-name">{event.data.title}</p>
                  <p class="past-card-date">{cardDate}</p>
                  <span class="past-card-link">View recap →</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- 4b. WHAT WE'RE READING CAROUSEL -->
  {sortedBooks.length > 0 && (
    <section class="reading-section">
      <div class="reading-header-row">
        <p class="eyebrow">What We're Reading</p>
        {sortedBooks.length > 5 && (
          <div class="carousel-controls">
            <button class="carousel-btn" id="books-prev-btn" aria-label="Previous" disabled>←</button>
            <button class="carousel-btn" id="books-next-btn" aria-label="Next">→</button>
          </div>
        )}
      </div>
      <div class="carousel-viewport">
        <div class="carousel-track" id="books-carousel-track">
          {sortedBooks.map(book => (
            <a href="/reading" class="book-cover-card" title={`${book.data.title} — ${book.data.author}`}>
              <img src={book.data.image} alt={book.data.title} class="book-cover-img" />
            </a>
          ))}
        </div>
      </div>
      <a href="/reading" class="reading-cta">See the full list →</a>
    </section>
  )}

  <!-- 5. QUOTES -->
  <section class="quotes-section">
    <div class="quote-card">
      <span class="quote-mark">"</span>
      <p class="quote-text">I didn't know my story was worth telling until I had a room to tell it in.</p>
      <span class="quote-attr">— Workshop participant</span>
    </div>
    <div class="quote-divider"></div>
    <div class="quote-card">
      <span class="quote-mark">"</span>
      <p class="quote-text">Writing about the 7 train felt like writing about every country at once.</p>
      <span class="quote-attr">— Workshop participant</span>
    </div>
  </section>

</BaseLayout>

<script>
  function initCarousel(trackId: string, prevId: string, nextId: string, visible: number) {
    const track = document.getElementById(trackId) as HTMLElement | null;
    const prevBtn = document.getElementById(prevId) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(nextId) as HTMLButtonElement | null;
    if (!track || !prevBtn || !nextBtn) return;

    let current = 0;
    const total = track.children.length;
    const gap = 16;

    function render() {
      const cardW = (track!.parentElement!.offsetWidth - gap * (visible - 1)) / visible;
      track!.style.transform = `translateX(-${current * (cardW + gap)}px)`;
      prevBtn!.disabled = current === 0;
      nextBtn!.disabled = current >= total - visible;
    }

    prevBtn.addEventListener('click', () => { current--; render(); });
    nextBtn.addEventListener('click', () => { current++; render(); });
    window.addEventListener('resize', render);
    render();
  }

  initCarousel('carousel-track', 'prev-btn', 'next-btn', 3);
  initCarousel('books-carousel-track', 'books-prev-btn', 'books-next-btn', 5);
</script>

<style>
  /* ── HERO ─────────────────────────────── */
  .hero {
    background: var(--color-dark);
    display: flex;
    min-height: 580px;
  }

  .hero-event {
    flex: 0 0 58%;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
    border-right: 1px solid rgba(255,255,255,0.06);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: top center;
    filter: blur(10px) brightness(0.70);
    transform: scale(1.12);
  }
  .hero-tint {
    position: absolute;
    inset: 0;
    background: rgba(42, 14, 24, 0.45);
  }
  .hero-card {
    position: relative;
    z-index: 2;
    background: rgba(23, 9, 16, 0.6);
    backdrop-filter: blur(2px);
    border: 1px solid rgba(255,255,255,0.12);
    border-top: 2px solid var(--color-coral);
    padding: 32px 28px;
    width: 100%;
    max-width: 380px;
  }
  .hero-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-coral);
    margin-bottom: 12px;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: 52px;
    font-weight: 600;
    color: var(--color-cream);
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .hero-tagline {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    color: var(--color-cream);
    margin-bottom: 16px;
    line-height: 1.45;
  }
  .hero-rule {
    width: 32px;
    height: 1px;
    background: var(--color-coral);
    margin-bottom: 14px;
  }
  .hero-series {
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 300;
    font-style: italic;
    color: rgba(250,246,241,0.65);
    margin-bottom: 10px;
  }
  .hero-meta {
    font-family: var(--font-sans);
    font-size: 10px;
    color: rgba(250,246,241,0.65);
    margin-bottom: 4px;
  }
  .hero-location { margin-bottom: 28px; }
  .hero-btns {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 20px;
  }
  .btn {
    display: block;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 12px 16px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .btn:hover { opacity: 0.8; text-decoration: none; }
  .btn-outline {
    border: 1px solid rgba(255,255,255,0.3);
    color: var(--color-cream);
  }
  .btn-solid {
    background: var(--color-coral);
    color: var(--color-cream);
  }

  /* ── HERO MESSAGING (right panel) ───────── */
  .hero-messaging {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #3d1a26;
    padding: 40px 36px;
    border-left: 1px solid rgba(255,255,255,0.06);
  }
  .hero-msg-headline {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 300;
    color: var(--color-cream);
    line-height: 1.45;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .hero-msg-headline em {
    font-style: italic;
    color: var(--color-coral);
  }
  .hero-msg-items {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-msg-item {
    padding-left: 14px;
    border-left: 2px solid var(--color-coral);
  }
  .hero-msg-title {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-cream);
    margin-bottom: 4px;
    line-height: 1.3;
  }
  .hero-msg-body {
    font-family: var(--font-serif);
    font-size: 14px;
    color: rgba(250,246,241,0.8);
    line-height: 1.6;
  }

  /* ── ABOUT QUOTE ──────────────────────── */
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 4px;
    color: var(--color-coral);
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .about-section {
    background: var(--color-off-white);
    padding: 64px 48px 72px;
  }
  .about-rule {
    width: 40px;
    height: 2px;
    background: var(--color-coral);
    margin-bottom: 28px;
  }
  .about-quote {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.65;
    color: var(--color-text);
    max-width: 640px;
  }
  .about-quote strong {
    font-style: normal;
    font-weight: 600;
    color: var(--color-wine);
  }
  .about-cta {
    display: inline-block;
    margin-top: 24px;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-coral);
    border-bottom: 1px solid var(--color-coral);
    padding-bottom: 3px;
    text-decoration: none;
  }
  .about-cta:hover { opacity: 0.8; text-decoration: none; }

  /* ── PAST WORKSHOPS CAROUSEL ──────────── */
  .past-section {
    background: var(--color-dark);
    padding: 64px 48px;
  }
  .past-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }
  .past-header .eyebrow { margin-bottom: 0; }
  .carousel-controls {
    display: flex;
    gap: 8px;
  }
  .carousel-btn {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    color: var(--color-cream);
    width: 36px;
    height: 36px;
    font-size: 16px;
    cursor: pointer;
    transition: border-color 0.2s, opacity 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .carousel-btn:hover:not(:disabled) { border-color: var(--color-coral); color: var(--color-coral); }
  .carousel-btn:disabled { opacity: 0.25; cursor: default; }

  .carousel-viewport {
    overflow: hidden;
    container-type: inline-size;
  }
  .carousel-track {
    display: flex;
    gap: 16px;
    transition: transform 0.35s ease;
  }
  .past-card {
    flex-shrink: 0;
    width: calc((100cqw - 32px) / 3);
    border: 1px solid rgba(255,255,255,0.07);
    background: var(--color-dark-mid);
    overflow: hidden;
    display: block;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .past-card:hover { border-color: var(--color-coral); text-decoration: none; }
  .past-card-img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }
  .past-card-body {
    padding: 14px 16px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .past-card-name {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-cream);
    margin-bottom: 5px;
  }
  .past-card-date {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--color-coral);
    text-transform: uppercase;
  }
  .past-card-link {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 1px;
    color: rgba(250,246,241,0.5);
    margin-top: 8px;
    display: block;
  }

  /* ── WHAT WE'RE READING CAROUSEL ─────── */
  .reading-section {
    background: var(--color-off-white);
    padding: 64px 48px;
  }
  .reading-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }
  .reading-header-row .eyebrow { margin-bottom: 0; }
  .book-cover-card {
    flex-shrink: 0;
    width: calc((100cqw - 64px) / 5);
    display: block;
  }
  .book-cover-img {
    width: 100%;
    aspect-ratio: 2/3;
    object-fit: cover;
    border: 1px solid rgba(0,0,0,0.08);
    transition: opacity 0.2s;
  }
  .book-cover-card:hover .book-cover-img { opacity: 0.85; }
  .reading-cta {
    display: inline-block;
    margin-top: 28px;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-coral);
    border-bottom: 1px solid var(--color-coral);
    padding-bottom: 3px;
    text-decoration: none;
  }
  .reading-cta:hover { opacity: 0.8; text-decoration: none; }

  /* ── QUOTES SECTION ──────────────────── */
  .quotes-section {
    background: var(--color-off-white);
    padding: 72px 48px;
    display: flex;
    gap: 0;
    align-items: stretch;
  }
  .quote-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 48px;
  }
  .quote-mark {
    font-family: var(--font-serif);
    font-size: 52px;
    color: var(--color-coral);
    opacity: 0.4;
    line-height: 0.5;
    margin-bottom: 20px;
    display: block;
  }
  .quote-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--color-dark);
    line-height: 1.7;
    margin-bottom: 16px;
  }
  .quote-attr {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--color-coral);
    text-transform: uppercase;
  }
  .quote-divider {
    width: 1px;
    background: rgba(0,0,0,0.1);
    flex-shrink: 0;
  }

  /* ── RESPONSIVE ──────────────────────── */
  @media (max-width: 768px) {
    .hero { flex-direction: column; min-height: unset; }
    .hero-event {
      flex: unset;
      width: 100%;
      min-height: 400px;
      border-right: none;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .hero-messaging { padding: 32px 20px; }
    .hero-msg-headline { font-size: 17px; }

    .about-section { padding: 48px 20px; }
    .about-quote { font-size: 20px; }

    .past-section { padding: 48px 20px; }
    .past-card { flex: 0 0 80vw; }

    .reading-section { padding: 48px 20px; }
    .book-cover-card { width: calc((100cqw - 16px) / 2); }

    .quotes-section { flex-direction: column; padding: 48px 20px; gap: 40px; }
    .quote-card { padding: 0; }
    .quote-divider { width: 100%; height: 1px; }
    .quote-text { font-size: 17px; }
  }
</style>
